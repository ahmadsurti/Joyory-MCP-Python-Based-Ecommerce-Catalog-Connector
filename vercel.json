{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{src/**,config/**}"
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index.py?route=mcp" },
    { "source": "/mcp/:path*", "destination": "/api/index.py?route=mcp/:path*" },
    { "source": "/health", "destination": "/api/index.py?route=health" },
    { "source": "/debug", "destination": "/api/index.py?route=debug" },
    { "source": "/api/:path*", "destination": "/api/index.py?route=:path*" },
    { "source": "/", "destination": "/api/index.py?route=" }
  ]
}
